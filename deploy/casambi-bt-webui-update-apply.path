[Unit]
Description=Start a Casambi BT WebGUI update apply when the web app asks for one

[Path]
# The web app (user casambi) creates this file; update.sh deletes it when it starts.
PathExists=/var/lib/casambi-bt-webui/update/apply-request
Unit=casambi-bt-webui-update@apply.service

[Install]
WantedBy=multi-user.target
