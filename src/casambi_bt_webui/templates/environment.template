# Template for /etc/casambi-bt-webui.env. deploy/install.sh creates that file with fresh secrets
# and keeps it on later runs; change settings afterwards with: sudoedit /etc/casambi-bt-webui.env
PORT=3000
NODE_ENV=production

# Unique per installation; the installer generates them. Changing CASAMBI_ENCRYPTION_KEY later
# makes stored Casambi credentials unreadable.
CASAMBI_ENCRYPTION_KEY=replace-with-a-unique-high-entropy-secret
CASAMBI_JWT_SECRET=replace-with-a-different-unique-high-entropy-secret

# A physical Raspberry Pi must use false. True is only for development without Bluetooth hardware.
CASAMBI_MOCK_MODE=false
CASAMBI_PYTHON_COMMAND=/opt/casambi-bt-webui/.venv/bin/python
CASAMBI_DB_PATH=/var/lib/casambi-bt-webui/casambi-bt-webui.db
# Persistent upstream casambi-bt cache; installer creates this directory as casambi:casambi with mode 0700.
CASAMBI_CACHE_PATH=/var/lib/casambi-bt-webui/casambi-bt-store

# mDNS advertiser for the HomeKit bridge: avahi (default on Linux; uses the avahi-daemon the installer sets up),
# ciao, resolved, or bonjour-hap. HomeKit itself is turned on in Admin -> HOMEKIT.
# CASAMBI_HOMEKIT_ADVERTISER=avahi

# Only when the WebGUI runs behind a reverse proxy (e.g. for HTTPS): trust its X-Forwarded-For header.
# Leave unset otherwise, or any client could choose its own address and evade the rate limit.
# CASAMBI_TRUST_PROXY=true
